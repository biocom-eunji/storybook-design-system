# Chromatic visual regression project token.
# 절대 평문으로 package.json/스크립트에 커밋하지 말 것.
# 발급: https://www.chromatic.com/manage?appId=<projectId>&accountId=<accountId>
#
# 사용 예:
#   export CHROMATIC_PROJECT_TOKEN=chpt_xxxxxxxxxxxx
#   npm run deploy:chromatic
#
# CI에서는 GitHub Actions Secret 또는 동등한 시크릿 매니저 사용.
CHROMATIC_PROJECT_TOKEN=
